    tree.heading("pid", text="PID")
    tree.heading("status", text="Status")
    tree.heading("mem", text="Memory")

    tree.column("name", width=200)
    tree.column("pid", width=80)
    tree.column("status", width=100)
    tree.column("mem", width=120)
    tree.pack(fill="both", expand=True)

    fake_processes = [
        ("explorer.exe", 1120, "Running", "35 MB"),
        ("chrome.exe", 1300, "Running", "150 MB"),
        ("cmd.exe", 1234, "Running", "4 MB"),
        ("svchost.exe", 1024, "Running", "21 MB"),
        ("securityscan.exe", 1400, "Suspended", "6 MB"),
        ("updateagent.exe", 1501, "Running", "12 MB"),
    ]

    for name, pid, status, mem in fake_processes:
        tree.insert("", "end", values=(name, pid, status, mem))

    def end_task():
        selection = tree.selection()

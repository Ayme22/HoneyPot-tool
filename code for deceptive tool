    browser_win.title("Internal Browser")

    login_frame = tk.Frame(browser_win)
    dashboard_frame = tk.Frame(browser_win)
    hr_frame = tk.Frame(browser_win)

    for frame in (login_frame, dashboard_frame, hr_frame):
        frame.grid(row=0, column=0, sticky='nsew')

    def raise_frame(frame):
        frame.tkraise()

    # Login Page
    tk.Label(login_frame, text="ACME Login", font=("Segoe UI", 14)).pack(pady=10)
    tk.Label(login_frame, text="Username").pack()
    user_entry = tk.Entry(login_frame)
    user_entry.pack()
    tk.Label(login_frame, text="Password").pack()
    pass_entry = tk.Entry(login_frame, show="*")
    pass_entry.pack()

    def check_login():
        with open(CRED_FILE) as f:
            creds = f.read().strip()
        if f"{user_entry.get()}:{pass_entry.get()}" == creds:
            raise_frame(dashboard_frame)
            browser_win.after(5000, lambda: messagebox.showwarning("Alert", "You've been caught!"))
        else:
            messagebox.showerror("Login Failed", "Invalid credentials.")

    tk.Button(login_frame, text="Login", command=check_login).pack(pady=10)

    # Dashboard Page
    tk.Label(dashboard_frame, text="Employee Dashboard", font=("Segoe UI", 14)).pack(pady=10)
    tk.Button(dashboard_frame, text="Go to HR Portal", command=lambda: raise_frame(hr_frame)).pack()

    # HR Portal

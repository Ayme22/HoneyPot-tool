def internal_browser():
    def raise_frame(frame):
        frame.tkraise()

    browser_win = tk.Tk()
    browser_win.geometry("800x600")
    browser_win.title("Internal Browser")

    login_frame = tk.Frame(browser_win)
    dashboard_frame = tk.Frame(browser_win)
    hr_frame = tk.Frame(browser_win)


    for frame in (login_frame, dashboard_frame, hr_frame):
        frame.place(relwidth=1, relheight=1)

    # Login Page
    tk.Label(login_frame, text="ACME Login", font=("Segoe UI", 14)).pack(pady=10)
    tk.Label(login_frame, text="Username").pack()
    user_entry = tk.Entry(login_frame)
    user_entry.pack()
    tk.Label(login_frame, text="Password").pack()
    pass_entry = tk.Entry(login_frame, show="*")
    pass_entry.pack()

    def check_login():
        fake_credentials = {"admin": "password123!"}
        username = user_entry.get()
        password = pass_entry.get()
        if fake_credentials.get(username) == password:
            raise_frame(dashboard_frame) 
        else:
            messagebox.showerror("Login Failed", "Invalid credentials.")

    login_button = tk.Button(login_frame, text="Login", command=check_login)
    login_button.pack(pady=10)
    
    # Dashboard Page
    tk.Label(dashboard_frame, text="Employee Dashboard", font=("Segoe UI", 14)).pack(pady=10)
    tk.Button(dashboard_frame, text="Go to HR Portal", command=lambda: raise_frame(hr_frame)).pack(pady=10)

    # HR Portal
    def generate_hr_dashboard():
        for widget in hr_frame.winfo_children():
            widget.destroy()

        tk.Label(hr_frame, text="HR Dashboard", font=("Segoe UI", 14)).pack(pady=10) 

        employee_names = ["John Smith", "Jane Doe", "Alice Johnson"]
        salaries = [120000, 95000, 85000]
        ratings = [4.5, 3.8, 4.0]

        # Create a figure with subplots
        fig, axs = plt.subplots(1, 2, figsize=(12, 6))
        axs[0].bar(employee_names, salaries, color='skyblue')
        axs[0].set_title('Employee Salaries')
        axs[0].set_xlabel('Employees')
        axs[0].set_ylabel('Salary ($)')

    
        # Plot Rating Data on the second subplot
        axs[1].pie(ratings, labels=employee_names, autopct='%1.1f%%', startangle=90, colors=['#ff9999','#66b3ff','#99ff99'])
        axs[1].set_title('Employee Ratings')
    
        # Adjust layout to avoid overlap
        plt.tight_layout()
    
        canvas = FigureCanvasTkAgg(fig, master=hr_frame)
        canvas.get_tk_widget().pack(fill="both", expand=True)
        canvas.draw()
        tk.Button(hr_frame, text="Back to Dashboard", command=lambda: raise_frame(dashboard_frame)).pack()

    tk.Button(hr_frame, text="Generate HR Dashboard", command=generate_hr_dashboard).pack()

    raise_frame(login_frame)
    browser_win.mainloop()


def fake_chat_window():
    chat_win = tk.Toplevel()
    chat_win.title("Team Chat")
    chat_win.geometry("400x300")
    text = tk.Text(chat_win, state="disabled", bg="white")
    text.pack(fill="both", expand=True)

    messages = [
        "John: Did you see the latest HR memo?",
        "Alice: VPN is down again...",
        "Bob: Lunch today?",
        "Jane: What's the password for HR?",
        "Alice: The password is ******",
        "IT-Bot: Your ticket #3421 is now closed."
    ]

    def update_chat():
        for msg in messages:
            text.config(state="normal")
            text.insert("end", msg + "\n")
            text.config(state="disabled")
            time.sleep(2)

    threading.Thread(target=update_chat, daemon=True).start()

def fake_task_manager():
    tm_win = tk.Toplevel()
    tm_win.title("Task Manager")
    tm_win.geometry("800x600")

    # Header
    header = tk.Label(tm_win, text="ACME Corp Task Manager", font=("Segoe UI", 14))
    header.pack(pady=5)

    # Frame for CPU usage graph
    graph_frame = tk.Frame(tm_win)
    graph_frame.pack(pady=10)

    # Matplotlib figure and axis for CPU usage chart
    fig, ax = plt.subplots(figsize=(6, 3))
    x_data = []
    y_data = []

    # Embed matplotlib canvas in Tkinter
    canvas = FigureCanvasTkAgg(fig, master=graph_frame)
    canvas.get_tk_widget().pack(fill="both", expand=True)

    # CPU/Memory stats
    stats_frame = tk.Frame(tm_win)
    stats_frame.pack(pady=5)

    cpu_label = tk.Label(stats_frame, text="CPU Usage: 0%")
    cpu_label.grid(row=0, column=0, padx=10)
    mem_label = tk.Label(stats_frame, text="Memory Usage: 0.0 GB / 8 GB")
    mem_label.grid(row=0, column=1, padx=10)

    def update_graph(frame):
        cpu_usage = random.randint(5, 95)
        mem_used = round(random.uniform(2.5, 7.5), 1)

        x_data.append(frame)
        y_data.append(cpu_usage)

        if len(x_data) > 30:
            x_data.pop(0)
            y_data.pop(0)

        ax.clear()
        ax.set_title("Live CPU Usage")
        ax.set_xlabel("Time (s)")
        ax.set_ylabel("CPU Usage (%)")
        ax.set_ylim(0, 100)
        ax.plot(x_data, y_data, color="blue", label="CPU Usage")
        ax.legend()

        canvas.draw()

        cpu_label.config(text=f"CPU Usage: {cpu_usage}%")
        mem_label.config(text=f"Memory Usage: {mem_used} GB / 8 GB")

    # Animate the graph
    tm_win.ani = animation.FuncAnimation(fig, update_graph, interval=1000)

    # Frame for process table
    process_frame = tk.Frame(tm_win)
    process_frame.pack(fill="both", expand=True, padx=10, pady=5)

    # Treeview for fake processes
    tree = ttk.Treeview(process_frame, columns=("name", "pid", "status", "mem"), show="headings")
